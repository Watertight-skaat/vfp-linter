# Everything the extension needs at runtime is bundled into
# client/out/extension.js and server/out/server.js by scripts/build.mjs.
# Nothing else ships -- no node_modules, no sources.
# NOTE: do not add `!` negation rules here. They are applied last and will
# happily re-include the whole of node_modules (this is how *.d.ts leaked in).
**/node_modules/**
**/*.ts
**/*.map
**/*.pegjs
**/*.tsbuildinfo
client/src/**
server/src/**
client/out/test/**
client/testFixture/**
scripts/**
test-files/**
eslint.config.mjs
.vscode/**
.github/**
.gitignore
**/tsconfig.json
**/package-lock.json
**/bun.lock
**/bun.lockb
*.vsix
debug_ast.json
CLAUDE.md
