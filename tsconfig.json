{
	"compilerOptions": {
		// Support 2 months of VSCode Releases
		"module": "node20",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"strict": true,
		// ESLint is not in the toolchain (typescript-eslint does not support TS 7), so the compiler carries the unused-code checks it used to provide.
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"sourceMap": true,
		// esbuild produces all build output; tsc is used only to type-check.
		"noEmit": true
	}
}
