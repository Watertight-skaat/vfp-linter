{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// Listed explicitly: under TypeScript 7 the ambient @types packages are not reliably
		// picked up by automatic discovery here, and being explicit is deterministic anyway.
		"types": ["node"]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
